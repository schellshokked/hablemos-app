# Required. Copy this file to .env.local for local dev, and add it in Vercel → Settings → Environment Variables.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_TEXT_MODEL=gpt-4.1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional: lock the app behind a family passcode (leave unset to keep it open)
# APP_PASSCODE=choose-something
